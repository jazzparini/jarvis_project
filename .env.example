# ==========================================
# JARVIS Environment Configuration Example
# ==========================================

# Entorno y logs
APP_ENV=development
LOG_LEVEL=INFO
TIMEZONE=America/Argentina/Buenos_Aires
REQUEST_TIMEOUT_SECONDS=60

# Telegram Bot
TELEGRAM_BOT_TOKEN=tu_telegram_bot_token_aqui
TELEGRAM_ALLOWED_USER_IDS=123456789
TELEGRAM_ALLOWED_CHAT_IDS=123456789
TELEGRAM_USE_WEBHOOK=false

# LLM Provider por defecto (gemini | hermes | anthropic)
DEFAULT_LLM_PROVIDER=gemini

# Google Gemini
GEMINI_API_KEY=tu_gemini_api_key_aqui
GEMINI_MODEL=gemini-2.5-flash

# Hermes (OpenAI compatible / vLLM / Ollama / OpenRouter / Local VPS Endpoint)
HERMES_API_BASE_URL=http://localhost:11434/v1
HERMES_API_KEY=none
HERMES_MODEL=hermes-3-llama-3.1-8b

# Anthropic Claude (opcional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-7-sonnet-20250219

# Persistencia
DATABASE_URL=sqlite+aiosqlite:///./data/jarvis.db

# Seguridad y Rate Limiting
ENCRYPTION_KEY=
RATE_LIMIT_PER_USER=20
